{
  "name": "focus-timer",
  "productName": "Focus Timer",
  "version": "1.0.0",
  "description": "Focus Timer - Pomodoro desktop app (tasks, streaks, analytics, ambient sounds)",
  "main": "electron/main.cjs",
  "author": "yousseifindx5",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV=1 electron .\"",
    "build:web": "tsc --noEmit && vite build",
    "start": "npm run build:web && electron .",
    "dist:win": "npm run build:web && electron-builder --win --x64 --publish never",
    "dist:mac": "npm run build:web && electron-builder --mac --publish never",
    "dist:linux": "npm run build:web && electron-builder --linux --publish never",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "wait-on": "^8.0.1",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "com.focustimer.app",
    "productName": "Focus Timer",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Focus-Timer-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Focus-Timer-Portable-${version}.exe"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yousseifindx5/focus-timer.git"
  },
  "homepage": "https://github.com/yousseifindx5/focus-timer"
}